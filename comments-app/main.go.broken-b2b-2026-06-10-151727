function getStep(price){
  price = String(price || "");

  if(price.includes("1л") || price.includes("5л") || price.includes("/л")) return 1;
  if(price.includes("/50 г")) return 50;
  if(price.includes("/100 г")) return 100;
  if(price.includes("/шт")) return 1;

