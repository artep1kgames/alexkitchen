function cartPlus(i){
  const x = cart[i];
  if(!x) return;
  const step = getStep(x.price);
  x.qty = Math.round((x.qty + step) * 10) / 10;
  updateCart();
  openCart();
}

function cartMinus(i){
  const x = cart[i];
  if(!x) return;
  const step = getStep(x.price);
  x.qty = Math.round((x.qty - step) * 10) / 10;
  if(x.qty <= 0){
    cart.splice(i, 1);
  }
  updateCart();
  openCart();
}

function cartRemove(i){
  cart.splice(i, 1);
  updateCart();
  openCart();
}

